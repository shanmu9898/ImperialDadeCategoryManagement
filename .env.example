# Imperial Dade Category Management — example environment file
# Copy to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------------
# Azure OpenAI — primary deployment used by interactive runs
# ---------------------------------------------------------------------------
# Endpoint for your Azure OpenAI resource (no trailing slash)
AZURE_OPENAI_ENDPOINT=

# Primary API key for the Azure OpenAI resource above
AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Azure OpenAI — batch deployment (optional)
# If unset, the primary key/endpoint above are reused for batch requests.
# Use a separate deployment if your batch quota differs from interactive.
# ---------------------------------------------------------------------------
AZURE_BATCH_OPENAI_ENDPOINT=
AZURE_BATCH_OPENAI_KEY=

# ---------------------------------------------------------------------------
# Pipeline runtime
# ---------------------------------------------------------------------------
# Root directory for input/output data (overrides repo-local default).
# Useful when data lives on a shared drive or cloud-mounted path.
IMPERIAL_DADE_DATA_DIR=

# Log level for the CLI and notebook (DEBUG | INFO | WARNING | ERROR)
IMPERIAL_DADE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Fornax — central data platform (SQL Server via pyodbc)
# ---------------------------------------------------------------------------
# Composed at runtime into:
#   DRIVER={FORNAX_DRIVER};SERVER={FORNAX_SERVER};DATABASE={FORNAX_DATABASE};
# UID/PWD are appended only if both are set; leave blank for Windows auth.
FORNAX_DRIVER=SQL Server
FORNAX_SERVER=ibp-db01
FORNAX_DATABASE=fornax
FORNAX_UID=
FORNAX_PWD=

# Override the connection factory if your team has a centralized helper.
# Format: "module.path:callable_name". The callable must return something
# pandas.read_sql can use as `con`. If set, the FORNAX_* vars above are ignored.
IMPERIAL_DADE_CONNECTION_FACTORY=

# Fornax table names — 3-part addressing (database.schema.table).
# These three live in the `fornax` database / `dbo` schema.
FORNAX_TABLE_SALSIFY=
FORNAX_TABLE_ITEM_SEGMENT=
FORNAX_TABLE_CONSOLIDATED_ITEMS=

# Sales table uses 3-part addressing (database.schema.table). The three
# components below are joined with dots at runtime, so leave FORNAX_TABLE_SALES
# unset unless you want to override the composed value with a literal.
FORNAX_SALES_DATA_DATABASE=
FORNAX_SALES_DATA_SCHEMA=
FORNAX_SALES_DATA_TABLE=
# FORNAX_TABLE_SALES=    # optional explicit override — wins over the 3-part vars above

# ---------------------------------------------------------------------------
# Microsoft Fabric lakehouse — Salsify <-> S2K item-master bridge
# ---------------------------------------------------------------------------
# SQL analytics endpoint hostname (no port; the loader appends ',1433'). Find
# it in Fabric under Lakehouse -> top-right "SQL analytics endpoint" ->
# Settings -> "SQL connection string". Looks like:
#   xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=
FABRIC_LAKEHOUSE=lh_idedw_business

# Authentication mode. Default pops a browser sign-in once (token cached in
# the user profile after that). For CI / service accounts, set this to
# ActiveDirectoryServicePrincipal and supply FABRIC_UID / FABRIC_PWD.
FABRIC_AUTH=ActiveDirectoryInteractive
FABRIC_UID=
FABRIC_PWD=

# Two-part identifier for the iSeries S2K item-master mirror. Default points
# at the schema we discovered in lh_idedw_business; override if the lakehouse
# changes its mirror layout.
FABRIC_TABLE_VIOITEM=src_s2k_r50modsdta.VIOITEM

# Reltio item-segment mapping (replaces empty fornax.dbo.Item_Segment).
FABRIC_TABLE_ITEM_SEGMENT=src_reltio.item_segment

# Sancus item clustering — groups the same physical product across branch
# companies so Stage 1 can read every description Imperial Dade holds for it.
#
# NOTE the three-part name. This table lives in the lh_idedw_sancus lakehouse,
# NOT the lh_idedw_business database FABRIC_LAKEHOUSE points at. Connecting
# directly with Database=lh_idedw_sancus hangs (the endpoint above is a
# warehouse endpoint), so it must be referenced cross-database like this.
# lh_idedw_business also exposes business.item_cluster and
# src_sancus_mirror.item_cluster if a same-database copy is preferred.
FABRIC_TABLE_ITEM_CLUSTER=[lh_idedw_sancus].[src_sancus].[item_cluster]

# Override the Fabric connection factory if your team has a centralized
# helper (e.g. one that injects an AAD access token). Format
# "module.path:callable_name"; the callable must return a DB-API 2.0
# connection. If set, the FABRIC_* vars above are ignored.
IMPERIAL_DADE_FABRIC_CONNECTION_FACTORY=
